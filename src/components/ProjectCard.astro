---
import type { ProjectItem } from '../i18n/projectsUi';

interface Props {
    project: ProjectItem;
    visitText?: string;
    codeText?: string;
}

const { project, visitText = 'Visit', codeText = 'Code' } = Astro.props;

// Хелпер для визначення стилю бейджа статусу
const getStatusBadgeStyle = (status: ProjectItem['status']) => {
    switch (status) {
        case 'Live SaaS':
            return 'border-emerald-500/30 bg-emerald-500/10 text-emerald-500';
        case 'Open Source':
            return 'border-indigo-500/30 bg-indigo-500/10 text-indigo-400';
        case 'In Development':
            return 'border-amber-500/30 bg-amber-500/10 text-amber-400';
        default:
            return 'border-zinc-500/30 bg-zinc-500/10 text-zinc-400';
    }
};
---

<div class="glow-card p-6 flex flex-col justify-between space-y-5 group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-300">

    <div class="space-y-4">
        <!-- TOP ROW: Header info & Action Buttons -->
        <div class="flex items-start justify-between gap-3 border-b border-zinc-200 dark:border-zinc-800/80 pb-4">

            <!-- Icon & Title Section -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition-transform">
                    {project.icon}
                </div>

                <div class="space-y-0.5">
                    <!-- Title & Compact Status Badge -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <h2 class="text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors leading-snug">
                            {project.title}
                        </h2>

                        <!-- МАЛИЙ ТЕГ СТАТУСУ -->
                        <span class={`inline-flex items-center font-mono text-[10px] font-bold px-2 py-0.5 rounded border shrink-0 ${getStatusBadgeStyle(project.status)}`}>
              ● {project.status}
            </span>
                    </div>

                    <p class="text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
                        {project.tagline}
                    </p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2 shrink-0">
                {project.githubUrl && (
                        <a
                                href={project.githubUrl}
                                target="_blank"
                                class="px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 text-xs font-bold hover:border-zinc-400 dark:hover:border-zinc-600 transition"
                        >
                            {codeText}
                        </a>
                )}

                {project.demoUrl && (
                        <a
                                href={project.demoUrl}
                                target="_blank"
                                class="px-3 py-1.5 rounded-lg bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-bold hover:opacity-90 transition flex items-center gap-1 shadow-sm"
                        >
                            <span>{visitText}</span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                        </a>
                )}
            </div>
        </div>

        <!-- DESCRIPTION -->
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {project.description}
        </p>
    </div>

    <!-- TECH STACK BADGES -->
    <div class="pt-2">
        <div class="flex flex-wrap gap-1.5">
            {project.stack.map((tech) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 text-zinc-600 dark:text-zinc-400 font-medium">
          {tech}
        </span>
            ))}
        </div>
    </div>

</div>