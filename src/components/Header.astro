---
import { LOCALES, type Locale, DEFAULT_LOCALE } from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
    currentLang?: Locale;
}

const { currentLang = DEFAULT_LOCALE } = Astro.props;
const t = ui[currentLang] || ui[DEFAULT_LOCALE];

// Отримуємо поточний pathname сторінки без мовного префіксу
const pathname = Astro.url.pathname;
const pathnameWithoutLang = pathname.replace(new RegExp(`^/${currentLang}`), '') || '';

const navItems = [
    { href: `/${currentLang}`, label: t['nav.home'] },
    { href: `/${currentLang}/career`, label: t['nav.career'] },
    { href: `/${currentLang}/stack`, label: t['nav.tech'] },
    { href: `/${currentLang}/research`, label: t['nav.research'] },
    { href: `/${currentLang}/projects`, label: t['nav.projects'] },
    { href: `/${currentLang}/socials`, label: t['nav.socials'] },
];
---



<header class="sticky top-0 z-50 w-full border-b border-zinc-200 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">

        <!-- Логотип -->
        <a href={`/${currentLang}`} class="flex items-center gap-2 group">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
            <span class="font-bold text-base tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors">
        Denys Skobalo
      </span>
        </a>

        <!-- Навігація (Desktop) -->
        <nav class="hidden md:flex items-center gap-1 bg-zinc-100/70 dark:bg-zinc-900/50 p-1.5 rounded-full border border-zinc-200/80 dark:border-zinc-800/60 text-xs font-medium">
            {navItems.map(item => (
                    <a
                            href={item.href}
                            class="px-3 py-1.5 rounded-full text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-zinc-800 transition-all"
                    >
                        {item.label}
                    </a>
            ))}
        </nav>

        <!-- Права частина: Перемикач мови, Теми та Кнопка "Увійти" -->
        <div class="flex items-center gap-2 sm:gap-3">

            <!-- Дропдаун мов -->
            <div class="relative group">
                <button class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 transition">
                    <span>{LOCALES[currentLang].flag}</span>
                    <span class="uppercase hidden sm:inline">{currentLang}</span>
                    <svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div class="absolute right-0 mt-1 w-36 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-1 z-50">
                    {Object.entries(LOCALES).map(([code, loc]) => (
                            <a
                                    href={`/${code}${pathnameWithoutLang}`}
                                    class={`flex items-center gap-2 px-3 py-2 text-xs rounded-lg transition-colors ${
                                        currentLang === code
                                            ? 'bg-zinc-100 dark:bg-zinc-800 font-semibold text-zinc-900 dark:text-white'
                                            : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 hover:text-zinc-900 dark:hover:text-white'
                                    }`}
                            >
                                <span>{loc.flag}</span>
                                <span>{loc.name}</span>
                            </a>
                    ))}
                </div>
            </div>

            <!-- Перемикач Dark/Light теми -->
            <button
                    id="theme-toggle"
                    aria-label="Toggle theme"
                    class="p-2 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 transition"
            >
                <!-- Сонце (Light) -->
                <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <!-- Місяць (Dark) -->
                <svg id="theme-toggle-dark-icon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>

            <!-- Кнопка Увійти (із викликом заглушки) -->
            <button
                    id="login-btn"
                    class="px-3.5 py-1.5 text-xs font-semibold rounded-lg bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 shadow-sm transition-all"
            >
                {t['nav.login']}
            </button>
        </div>
    </div>
</header>

<!-- Модальне вікно Centered Modal -->
<dialog
        id="auth-modal"
        class="fixed inset-0 m-auto bg-transparent backdrop:bg-zinc-950/80 p-4 max-w-md w-full focus:outline-none"
>
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-6 rounded-2xl shadow-2xl text-center space-y-4">
        <div class="w-12 h-12 bg-amber-500/10 text-amber-500 rounded-full flex items-center justify-center mx-auto border border-amber-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{t['modal.dev_title']}</h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {t['modal.dev_desc']}
        </p>
        <button id="close-modal-btn" class="w-full py-2 text-xs font-medium bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 rounded-lg transition">
            {t['modal.close']}
        </button>
    </div>
</dialog>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    // Логіка модалки-заглушки
    const modal = document.getElementById('auth-modal') as HTMLDialogElement | null;
    const loginBtn = document.getElementById('login-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');

    loginBtn?.addEventListener('click', () => modal?.showModal());
    closeModalBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal?.close();
    });
</script>