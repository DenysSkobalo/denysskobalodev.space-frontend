---
import { LOCALES, type Locale, DEFAULT_LOCALE } from '@/i18n/locales';
import { navUi } from '@/i18n/navUi';
import StatusDot from './ui/StatusDot.astro';

interface Props {
    currentLang?: Locale;
}

const { currentLang = DEFAULT_LOCALE } = Astro.props;
const nav = navUi[currentLang] || navUi[DEFAULT_LOCALE];

const pathname = Astro.url.pathname;
const pathnameWithoutLang = pathname.replace(new RegExp(`^/${currentLang}`), '') || '';

const navItems = [
    { href: `/${currentLang}`, label: nav.home },
    { href: `/${currentLang}/career`, label: nav.career },
    { href: `/${currentLang}/stack`, label: nav.stack },
    { href: `/${currentLang}/research`, label: nav.research },
    { href: `/${currentLang}/projects`, label: nav.projects },
    { href: `/${currentLang}/devlog`, label: nav.devlog },
    { href: `/${currentLang}/socials`, label: nav.socials },
];

const isItemActive = (href: string) => {
    if (href === `/${currentLang}`) {
        return pathname === `/${currentLang}` || pathname === `/${currentLang}/`;
    }
    return pathname.startsWith(href);
};

// Словарик підписів для авторизації та кнопок модалки залежно від мови
const modalTexts = {
    en: { login: 'Sign In', dev_title: 'Authentication Module', dev_desc: 'User auth and personalized dashboard features are under development.', close: 'Got it' },
    uk: { login: 'Увійти', dev_title: 'Модуль Авторизації', dev_desc: 'Функціонал особистого кабінету та авторизація знаходяться в розробці.', close: 'Зрозуміло' },
    fr: { login: 'Connexion', dev_title: 'Module d\'Authentification', dev_desc: 'L\'espace personnel et l\'authentification sont en cours de développement.', close: 'Compris' },
};
const mText = modalTexts[currentLang] || modalTexts['en'];
---

<header class="sticky top-0 z-50 w-full border-b border-zinc-200 dark:border-zinc-800/80 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-2">

        <!-- Logo -->
        <a href={`/${currentLang}`} class="flex items-center gap-2 group shrink-0">
            <StatusDot color="emerald" size="sm" />
            <span class="font-bold text-sm lg:text-base tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors whitespace-nowrap">
                Denys Skobalo
            </span>
        </a>

        <!-- Navigation (адаптовано під додавання пункту DevLog) -->
        <nav class="hidden xl:flex items-center gap-0.5 bg-zinc-100/70 dark:bg-zinc-900/50 p-1.5 rounded-full border border-zinc-200/80 dark:border-zinc-800/60 text-xs font-medium">
            {navItems.map(item => {
                const active = isItemActive(item.href);
                return (
                        <a
                                href={item.href}
                                class={`px-2.5 py-1.5 rounded-full transition-all whitespace-nowrap ${
                                    active
                                        ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white font-semibold shadow-xs'
                                        : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white/50 dark:hover:bg-zinc-800/50'
                                }`}
                        >
                            {item.label}
                        </a>
                );
            })}
        </nav>

        <!-- Control Buttons -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
            <!-- Language Dropdown -->
            <div class="relative group hidden xl:block">
                <button type="button" class="flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700 transition cursor-pointer">
                    <span>{LOCALES[currentLang].flag}</span>
                    <span class="uppercase">{currentLang}</span>
                    <svg class="w-3 h-3 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>

                <div class="absolute right-0 mt-1 w-36 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-1 z-50">
                    {Object.entries(LOCALES).map(([code, loc]) => (
                            <a
                                    href={`/${code}${pathnameWithoutLang}`}
                                    class={`flex items-center gap-2 px-3 py-2 text-xs rounded-lg transition-colors ${
                                        currentLang === code
                                            ? 'bg-zinc-100 dark:bg-zinc-800 font-semibold text-zinc-900 dark:text-white'
                                            : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800/50 hover:text-zinc-900 dark:hover:text-white'
                                    }`}
                            >
                                <span>{loc.flag}</span>
                                <span>{loc.name}</span>
                            </a>
                    ))}
                </div>
            </div>

            <!-- Dark / Light Theme Toggle -->
            <button
                    id="theme-toggle"
                    type="button"
                    aria-label="Toggle theme"
                    class="p-2 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 hover:border-zinc-300 dark:hover:border-zinc-700 transition cursor-pointer shrink-0"
            >
                <svg id="theme-toggle-light-icon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <svg id="theme-toggle-dark-icon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            </button>

            <!-- Sign In Button -->
            <button
                    id="login-btn"
                    type="button"
                    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 shadow-xs transition-all hidden xl:block cursor-pointer whitespace-nowrap"
            >
                {mText.login}
            </button>

            <!-- Mobile / Tablet Menu Button (xl:hidden) -->
            <button
                    id="mobile-menu-btn"
                    type="button"
                    aria-label="Open mobile menu"
                    class="xl:hidden p-2 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 cursor-pointer shrink-0"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden xl:hidden border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 pt-3 pb-5 space-y-4">
        <div class="space-y-1">
            {navItems.map(item => {
                const active = isItemActive(item.href);
                return (
                        <a
                                href={item.href}
                                class={`block px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${
                                    active
                                        ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white font-bold'
                                        : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900'
                                }`}
                        >
                            {item.label}
                        </a>
                );
            })}
        </div>

        <div class="pt-3 border-t border-zinc-200 dark:border-zinc-800 space-y-3">
            <div>
                <span class="block text-[10px] font-mono font-bold uppercase text-zinc-400 mb-2 px-1">Select Language</span>
                <div class="grid grid-cols-3 gap-2">
                    {Object.entries(LOCALES).map(([code, loc]) => (
                            <a
                                    href={`/${code}${pathnameWithoutLang}`}
                                    class={`flex items-center justify-center gap-1.5 py-2 px-2 text-xs rounded-xl border transition ${
                                        currentLang === code
                                            ? 'border-emerald-500 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-bold'
                                            : 'border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400'
                                    }`}
                            >
                                <span>{loc.flag}</span>
                                <span class="uppercase">{code}</span>
                            </a>
                    ))}
                </div>
            </div>

            <button
                    id="mobile-login-btn"
                    type="button"
                    class="w-full text-center py-2.5 rounded-xl text-xs font-bold bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 transition cursor-pointer"
            >
                {mText.login}
            </button>
        </div>
    </div>
</header>

<dialog
        id="auth-modal"
        class="fixed inset-0 m-auto bg-transparent backdrop:bg-zinc-950/80 p-4 max-w-md w-full focus:outline-none"
>
    <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 p-6 rounded-2xl shadow-2xl text-center space-y-4">
        <div class="w-12 h-12 bg-amber-500/10 text-amber-500 rounded-full flex items-center justify-center mx-auto border border-amber-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        </div>
        <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{mText.dev_title}</h3>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {mText.dev_desc}
        </p>
        <button id="close-modal-btn" type="button" class="w-full py-2.5 text-xs font-semibold bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-900 dark:text-zinc-100 rounded-xl transition cursor-pointer">
            {mText.close}
        </button>
    </div>
</dialog>

<script>
    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });

    const modal = document.getElementById('auth-modal') as HTMLDialogElement | null;
    const loginBtn = document.getElementById('login-btn');
    const mobileLoginBtn = document.getElementById('mobile-login-btn');
    const closeModalBtn = document.getElementById('close-modal-btn');

    loginBtn?.addEventListener('click', () => modal?.showModal());
    mobileLoginBtn?.addEventListener('click', () => {
        modal?.showModal();
        document.getElementById('mobile-menu')?.classList.add('hidden');
    });
    closeModalBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal?.close();
    });

    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuBtn?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
    });
</script>