---
export const prerender = false;

import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Admin Login">
    <div class="min-h-[70vh] flex items-center justify-center py-12 px-4">
        <div class="max-w-md w-full space-y-6 glow-card p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800">
            <div class="text-center space-y-2">
                <h1 class="text-2xl font-bold text-zinc-900 dark:text-white">Admin Authentication</h1>
                <p class="text-xs text-zinc-500">Введіть пароль доступу для керування проєктами</p>
            </div>

            <form id="login-form" class="space-y-4">
                <div>
                    <label for="password" class="block text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 mb-1">
                        Password
                    </label>
                    <input
                            type="password"
                            id="password"
                            name="password"
                            required
                            placeholder="••••••••"
                            class="w-full px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    />
                </div>

                <div id="error-msg" class="text-xs text-red-500 hidden font-medium text-center"></div>

                <button
                        type="submit"
                        class="w-full py-2.5 px-4 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-bold text-xs transition shadow-sm"
                >
                    Sign In
                </button>
            </form>
        </div>
    </div>
</BaseLayout>

<script>
    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (errorMsg) errorMsg.classList.add('hidden');

        const passwordInput = document.getElementById('password') as HTMLInputElement;

        try {
            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ password: passwordInput.value }),
            });

            if (res.ok) {
                window.location.href = '/admin';
            } else {
                const data = await res.json();
                if (errorMsg) {
                    errorMsg.textContent = data.message || 'Помилка авторизації';
                    errorMsg.classList.remove('hidden');
                }
            }
        } catch (err) {
            if (errorMsg) {
                errorMsg.textContent = 'Збій мережі. Спробуйте ще раз.';
                errorMsg.classList.remove('hidden');
            }
        }
    });
</script>