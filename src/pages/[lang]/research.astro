---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Footer from '@/components/Footer.astro';
import { getI18nStaticPaths, getValidLocale } from '@/utils/i18n';

export const prerender = true;

export const getStaticPaths = getI18nStaticPaths;

const { lang } = Astro.params;
const validLang = getValidLocale(lang);

const texts = {
    en: {
        title: 'Research & System Blueprints',
        subtitle: 'Engineering notes, architectural RFCs, and memory profiling benchmarks.',
        badge: 'UNDER DEVELOPMENT',
        heading: 'Section Under Active Development',
        description: 'I am currently preparing deep-dive technical articles on distributed consensus protocols, Go memory allocation internals, and ClickHouse analytics pipelines. Check back soon!',
        btn: 'Explore Tech Stack Instead',
    },
    uk: {
        title: 'Дослідження та Архитектурні RFC',
        subtitle: 'Інженерні нотатки, специфікації систем та бенчмарки профілювання пам\'яті.',
        badge: 'В РОЗРОБЦІ',
        heading: 'Розділ знаходиться в розробці',
        description: 'Наразі я готую детальні технічні статті про протоколи консенсусу, оптимізацію пам\'яті в Go та побудову аналітичних пайплайнів у ClickHouse. Матеріали з\'являться незабаром!',
        btn: 'Переглянути Стек Технологій',
    },
    fr: {
        title: 'Recherche & Architecture Système',
        subtitle: 'Notes d\'ingénierie, RFCs d\'architecture et benchmarks de profilage mémoire.',
        badge: 'EN DÉVELOPPEMENT',
        heading: 'Section en cours de développement',
        description: 'Je prépare actuellement des articles techniques approfondis sur les protocoles de consensus distribué et l\'optimisation mémoire en Go. Revenez bientôt !',
        btn: 'Explorer la Stack Technique',
    },
};

const t = texts[validLang];
---

<BaseLayout title={`Research — Denys Skobalo`} lang={validLang}>
    <Header slot="header" currentLang={validLang} />

    <div class="space-y-12 py-6">
        <PageHeader
                title={t.title}
                subtitle={t.subtitle}
                badgeText={t.badge}
                badgeVariant="amber"
        />

        <div class="glow-card p-12 text-center max-w-2xl mx-auto space-y-6 my-12">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-3xl">
                🧠
            </div>

            <div class="space-y-2">
                <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">
                    {t.heading}
                </h2>
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                    {t.description}
                </p>
            </div>

            <div class="pt-2">
                <a
                        href={`/${validLang}/stack`}
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-semibold text-xs hover:opacity-90 transition"
                >
                    {t.btn} →
                </a>
            </div>
        </div>
    </div>

    <Footer slot="footer" text="Denys Skobalo. Research & Blueprints." />
</BaseLayout>