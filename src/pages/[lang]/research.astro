---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import TechTag from '@/components/ui/TechTag.astro';
import Footer from '@/components/Footer.astro';
import { researchUi, MOCK_RESEARCH_ITEMS } from '@/i18n/researchUi';
import { getI18nStaticPaths, getValidLocale } from '@/utils/i18n';

export const getStaticPaths = getI18nStaticPaths;

const { lang } = Astro.params;
const validLang = getValidLocale(lang);
const t = researchUi[validLang];
---

<BaseLayout title="Research & Papers — Denys Skobalo" lang={validLang}>
    <Header slot="header" currentLang={validLang} />

    <div class="space-y-8 py-6 max-w-4xl mx-auto">
        <PageHeader
                title={t.title}
                subtitle={t.subtitle}
                badgeText="SYSTEM ARCHITECTURE PAPERS"
                badgeVariant="amber"
        />

        <div class="space-y-4">
            {MOCK_RESEARCH_ITEMS.map((item) => (
                    <a
                            href={`/${validLang}/research/${item.slug}`}
                            class="glow-card p-6 block space-y-4 group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-300"
                    >
                        <div class="flex flex-wrap items-center justify-between gap-2">
                        <span class="font-mono text-[10px] font-bold px-2.5 py-0.5 rounded border border-amber-500/30 bg-amber-500/10 text-amber-500">
                            {item.category}
                        </span>
                            <div class="font-mono text-[11px] text-zinc-500 flex items-center gap-3">
                                <span>{item.date}</span>
                                <span>•</span>
                                <span>{item.readTime}</span>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors">
                                {item.title}
                            </h2>
                            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                                {item.summary}
                            </p>
                        </div>

                        <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200/60 dark:border-zinc-800/60">
                            <div class="flex flex-wrap gap-1.5">
                                {item.tags.map((tag) => (
                                        <TechTag label={tag} prefix="#" />
                                ))}
                            </div>
                            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">
                            {t.read_article}
                        </span>
                        </div>
                    </a>
            ))}
        </div>
    </div>

    <Footer slot="footer" text="Denys Skobalo. Research & Engineer Notes." />
</BaseLayout>