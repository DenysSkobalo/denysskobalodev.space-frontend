---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { LOCALES, type Locale, DEFAULT_LOCALE } from '../../i18n/locales';
import { researchUi, MOCK_RESEARCH_ITEMS } from '../../i18n/researchUi';
import {projectsUi} from "../../i18n/projectsUi.ts";

export function getStaticPaths() {
    return Object.keys(LOCALES).map((lang) => ({
        params: { lang },
    }));
}
const { lang } = Astro.params as { lang: Locale };

const currentLang = (lang in researchUi ? lang : DEFAULT_LOCALE) as keyof typeof researchUi;
const t = researchUi[currentLang];
---

<BaseLayout title="Research & Papers — Denys Skobalo" lang={lang}>
    <Header slot="header" currentLang={lang} />

    <div class="space-y-8 py-6 max-w-4xl mx-auto">

        <!-- HEADER WITH PROPER SPACING & BORDER -->
        <div class="space-y-4 pb-6 mb-8 border-b border-zinc-200 dark:border-zinc-800">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-500 text-[11px] font-mono font-bold">
                🧠 SYSTEM ARCHITECTURE PAPERS
            </div>
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
                {t.title}
            </h1>
            <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
                {t.subtitle}
            </p>
        </div>

        <!-- PAPERS LIST -->
        <div class="space-y-4">
            {MOCK_RESEARCH_ITEMS.map((item) => (
                    <a
                            href={`/${lang}/research/${item.slug}`}
                            class="glow-card p-6 block space-y-4 group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all duration-300"
                    >
                        <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="font-mono text-[10px] font-bold px-2.5 py-0.5 rounded border border-amber-500/30 bg-amber-500/10 text-amber-500">
              {item.category}
            </span>

                            <div class="font-mono text-[11px] text-zinc-500 flex items-center gap-3">
                                <span>{item.date}</span>
                                <span>•</span>
                                <span>{item.readTime}</span>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors">
                                {item.title}
                            </h2>
                            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
                                {item.summary}
                            </p>
                        </div>

                        <div class="pt-2 flex flex-wrap items-center justify-between gap-4 border-t border-zinc-200/60 dark:border-zinc-800/60">
                            <div class="flex flex-wrap gap-1.5">
                                {item.tags.map((tag) => (
                                        <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 font-medium">
                  #{tag}
                </span>
                                ))}
                            </div>

                            <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">
              {t.read_article}
            </span>
                        </div>
                    </a>
            ))}
        </div>

    </div>

    <footer slot="footer" class="border-t border-zinc-200 dark:border-zinc-800 py-8 text-center text-xs text-zinc-500">
        © {new Date().getFullYear()} Denys Skobalo. Research & Engineering Notes.
    </footer>
</BaseLayout>