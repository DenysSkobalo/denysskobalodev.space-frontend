---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Badge from '@/components/ui/Badge.astro';
import Footer from "@/components/Footer.astro";
import { projectsUi, MOCK_PROJECTS } from '@/i18n/projectsUi';
import { getI18nStaticPaths, getValidLocale } from '@/utils/i18n';
import PageHeader from '@/components/ui/PageHeader.astro';

export const getStaticPaths = getI18nStaticPaths;

const { lang } = Astro.params;
const validLang = getValidLocale(lang);
const t = projectsUi[validLang];
---

<BaseLayout title="Products & SaaS — Denys Skobalo" lang={validLang}>
    <Header slot="header" currentLang={validLang} />

    <div class="space-y-8 py-6">
        <PageHeader
                title={t.title}
                subtitle={t.subtitle}
                badgeText="PRODUCTS & SAAS PORTFOLIO"
                badgeVariant="emerald"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {MOCK_PROJECTS.map((project) => (
                    <ProjectCard
                            project={project}
                            visitText={t.visit_btn}
                            codeText={t.code_btn}
                    />
            ))}
        </div>
    </div>

    <Footer slot="footer" text="Denys Skobalo. Shipping Hub." />
</BaseLayout>