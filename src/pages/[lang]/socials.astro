---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import Footer from "@/components/Footer.astro";
import { socialsUi, SOCIAL_CHANNELS } from '@/i18n/socialsUi';
import { getI18nStaticPaths, getValidLocale } from '@/utils/i18n';

export const prerender = true;

export const getStaticPaths = getI18nStaticPaths;

const { lang } = Astro.params;
const validLang = getValidLocale(lang);
const t = socialsUi[validLang];
---

<BaseLayout title="Socials & Channels — Denys Skobalo" lang={validLang}>
    <Header slot="header" currentLang={validLang} />

    <div class="space-y-8 py-6 max-w-4xl mx-auto">
        <PageHeader
                title={t.title}
                subtitle={t.subtitle}
                badgeText="GET IN TOUCH & CHANNELS"
                badgeVariant="emerald"
                pulse={true}
        />

        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 max-w-2xl mx-auto">
            {SOCIAL_CHANNELS.map((item) => {
                const isExternal = item.url.startsWith('http');
                return (
                        <a
                                href={item.url}
                                target={isExternal ? "_blank" : undefined}
                                rel={isExternal ? "noopener noreferrer" : undefined}
                                title={`${item.name} (${item.handle})`}
                                class="glow-card w-20 h-20 sm:w-24 sm:h-24 rounded-2xl flex items-center justify-center transition-all duration-300 shadow-sm p-4 group hover:-translate-y-1.5 hover:shadow-lg hover:border-emerald-500/50"
                        >
                            <div class="w-12 h-12 sm:w-16 sm:h-16 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                <SocialIcon iconId={item.id} />
                            </div>
                        </a>
                );
            })}
        </div>
    </div>

    <Footer slot="footer" text="Denys Skobalo. Social Linktree Hub." />
</BaseLayout>