---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { LOCALES, type Locale, DEFAULT_LOCALE } from '../../i18n/locales';
import { socialsUi, SOCIAL_CHANNELS } from '../../i18n/socialsUi';

export function getStaticPaths() {
    return Object.keys(LOCALES).map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params as { lang: Locale };

const currentLang = (lang in socialsUi ? lang : DEFAULT_LOCALE) as keyof typeof socialsUi;
const t = socialsUi[currentLang];
---

<BaseLayout title="Socials & Channels — Denys Skobalo" lang={lang}>
    <Header slot="header" currentLang={lang} />

    <div class="space-y-8 py-6 max-w-4xl mx-auto">

        <!-- HEADER WITH PROPER MARGIN & PADDING SPACING -->
        <div class="space-y-4 pb-8 mb-10 border-b border-zinc-200 dark:border-zinc-800">
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-500 text-[11px] font-mono font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                GET IN TOUCH & CHANNELS
            </div>
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
                {t.title}
            </h1>
            <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
                {t.subtitle}
            </p>
        </div>

        <!-- SEPARATE CARDS WITH PROPER GAPS -->
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 max-w-2xl mx-auto">
            {SOCIAL_CHANNELS.map((item) => (
                    <a
                            href={item.url}
                            {...(item.url.startsWith('http') ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                            title={`${item.name} (${item.handle})`}
                            class="glow-card w-20 h-20 sm:w-24 sm:h-24 rounded-2xl flex items-center justify-center transition-all duration-300 shadow-sm p-4 group hover:-translate-y-1.5 hover:shadow-lg hover:border-emerald-500/50"
                    >
                        <!-- SVG CONTAINER -->
                        <div class="w-12 h-12 sm:w-16 sm:h-16 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">

                            {/* TELEGRAM */}
                            {item.id === 'telegram' && (
                                    <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120" fill="none" class="w-full h-full">
                                        <g clip-path="url(#clip0_10_5067)">
                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M27.4178 0.583008H92.5822C99.6937 0.603515 106.508 3.45067 111.537 8.50247C116.565 13.5543 119.399 20.4001 119.42 27.5444V92.4654C119.397 99.6081 116.562 106.451 111.533 111.501C106.505 116.551 99.692 119.397 92.5822 119.417H27.4178C20.308 119.397 13.4951 116.551 8.46676 111.501C3.43844 106.451 0.60324 99.6081 0.580276 92.4654V27.5444C0.60069 20.4001 3.43476 13.5543 8.46335 8.50247C13.4919 3.45067 20.3063 0.603515 27.4178 0.583008Z" fill="white"/>
