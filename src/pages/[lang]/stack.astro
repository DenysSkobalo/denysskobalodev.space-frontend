---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Footer from '@/components/Footer.astro';
import { stackUi, MOCK_TECH_STACK } from '@/i18n/stackUi';
import { getI18nStaticPaths, getValidLocale } from '@/utils/i18n';

export const getStaticPaths = getI18nStaticPaths;

const { lang } = Astro.params;
const validLang = getValidLocale(lang);
const t = stackUi[validLang];
---

<BaseLayout title="Tech Stack — Denys Skobalo" lang={validLang}>
    <Header slot="header" currentLang={validLang} />

    <div class="space-y-10 py-6">
        <PageHeader
                title={t.title}
                subtitle={t.subtitle}
                badgeText="INTERACTIVE TECH RADAR"
                badgeVariant="emerald"
        />

        <div class="space-y-6">
            <div class="flex flex-wrap gap-2 border-b border-zinc-200 dark:border-zinc-800 pb-3" id="filter-tabs">
                <button data-filter="all" class="filter-btn active px-3.5 py-1.5 rounded-lg text-xs font-medium bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 transition">
                    {t.filter_all}
                </button>
                <button data-filter="backend" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition">
                    {t.filter_backend}
                </button>
                <button data-filter="database" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition">
                    {t.filter_database}
                </button>
                <button data-filter="devops" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition">
                    {t.filter_devops}
                </button>
                <button data-filter="architecture" class="filter-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition">
                    {t.filter_architecture}
                </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="tech-grid">
                {MOCK_TECH_STACK.map((tech) => (
                        <div
                                data-category={tech.category}
                                class="tech-card glow-card p-5 space-y-4 flex flex-col justify-between"
                        >
                            <div class="space-y-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-3xl">{tech.icon}</span>
                                    <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-500/30 bg-emerald-500/10 text-emerald-500">
                                    {tech.level}
                                </span>
                                </div>
                                <div>
                                    <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100">
                                        {tech.name}
                                    </h3>
                                    <span class="font-mono text-xs text-zinc-500">
                                    {tech.experienceYears} {t.exp_years}
                                </span>
                                </div>
                                <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
                                    {tech.shortDesc}
                                </p>
                            </div>
                            <a
                                    href={`/${validLang}/stack/${tech.slug}`}
                                    class="pt-3 border-t border-zinc-200 dark:border-zinc-800 flex items-center justify-between text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
                            >
                                <span>{t.view_details}</span>
                            </a>
                        </div>
                ))}
            </div>
        </div>
    </div>

    <Footer slot="footer" text="Denys Skobalo. Tech Stack Architecture." />
</BaseLayout>

<script>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.tech-card');

    buttons.forEach(btn => {
        btn.addEventListener('click', () => {
            const filter = btn.getAttribute('data-filter');

            buttons.forEach(b => {
                b.classList.remove('bg-zinc-900', 'dark:bg-zinc-100', 'text-white', 'dark:text-zinc-900');
                b.classList.add('text-zinc-600', 'dark:text-zinc-400');
            });

            btn.classList.add('bg-zinc-900', 'dark:bg-zinc-100', 'text-white', 'dark:text-zinc-900');
            btn.classList.remove('text-zinc-600', 'dark:text-zinc-400');

            cards.forEach(card => {
                const item = card as HTMLElement;
                if (filter === 'all' || item.dataset.category === filter) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        });
    });
</script>