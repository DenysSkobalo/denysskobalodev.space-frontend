---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import HeroSection from '@/components/HeroSection.astro';
import Footer from '@/components/Footer.astro';
import { getI18nStaticPaths, getValidLocale } from '@/utils/i18n';

export const getStaticPaths = getI18nStaticPaths;

const { lang } = Astro.params;
const validLang = getValidLocale(lang);
---

<BaseLayout title="Denys Skobalo — Senior Backend Engineer & System Architect" lang={validLang}>
    <Header slot="header" currentLang={validLang} />
    <HeroSection lang={validLang} />
    <Footer slot="footer" text="Denys Skobalo. All rights reserved." />
</BaseLayout>